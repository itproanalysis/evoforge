# Server-only configuration (never use NEXT_PUBLIC_* for secrets).
# The browser calls the same-origin proxy at /api/evoforge; no API base
# URL is exposed to the client.
EVO_API_BASE=http://localhost:8080
# Owner login (single account).
EVO_OWNER_USER=
# Password hash format: scrypt$N$r$p$saltHex$hashHex
EVO_OWNER_PASSWORD_HASH=
# Random 32+ character secret binding session cookies (HMAC).
EVO_SESSION_SECRET=
# Web auth mode (server-only): 'session' (default, owner login required) or
# 'none' (owner-only deployment with no login screen; the web origin is the
# only gate). Read at runtime. Any value other than 'none' means 'session'.
EVO_WEB_AUTH=session
# In 'none' mode, mutating web requests (POST via /api/evoforge) are
# rate-limited per client IP per rolling minute. GET is not limited.
EVO_WEB_POST_PER_MIN=20
