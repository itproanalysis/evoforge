MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MODEL_BUILDER=muse-spark-1.3
MODEL_CRITIC=muse-spark-1.3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evoforge
# Internal kernel API: dedicated server-owned project and a random 32+ character token.
# Keep the token on trusted servers; never use NEXT_PUBLIC_* for it.
EVO_KERNEL_TOKEN=
EVO_TENANT_ID=
EVO_PROJECT_ID=
# Required by /v1/kernel/builder-calls: server-approved price version, not a rate calculation.
EVO_PRICE_TABLE_VERSION=
# memory (local compatibility) or postgres (durable private evidence/events/links).
# Requires extension 003 and a pre-provisioned project; does not persist the demo ledger/commands.
EVO_STATE_BACKEND=memory
# Fixed server-side owner UUID used by canonical command acceptance.
EVO_COMMAND_ACTOR_ID=
GITHUB_APP_ID=
GITHUB_APP_PEM_PATH=
EVO_PROJECT_BUDGET_CENTS=50000
