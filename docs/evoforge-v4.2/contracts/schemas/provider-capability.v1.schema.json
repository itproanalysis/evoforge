{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoforge.example/schemas/provider-capability-v1.json",
  "title": "EvoForge Provider Capability Registry entry v1",
  "description": "Every number is per model family and expires. The planner refuses to use an entry whose verified_at is older than max_age_days (default 14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry_id", "provider", "model_match", "verified_at", "source_urls", "caching"],
  "properties": {
    "entry_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "provider": { "enum": ["openai", "anthropic", "google", "meta", "other"] },
    "model_match": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verified_at": { "type": "string", "format": "date" },
    "max_age_days": { "type": "integer", "minimum": 1, "maximum": 90 },
    "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "caching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implicit_default", "can_disable", "explicit_supported", "min_cacheable_tokens", "write_multiplier", "read_multiplier", "usage_fields"],
      "properties": {
        "implicit_default": { "type": "boolean" },
        "can_disable": { "type": "boolean", "description": "Whether arm A0_RAW_NOCACHE is runnable on this model." },
        "disable_method": { "type": "string" },
        "explicit_supported": { "type": "boolean" },
        "explicit_method": { "type": "string" },
        "max_breakpoints": { "type": ["integer", "null"], "minimum": 1 },
        "min_cacheable_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "ttl_options": { "type": "array", "items": { "type": "string" } },
        "write_multiplier": { "type": ["object", "null"], "additionalProperties": { "type": "number", "minimum": 0 } },
        "read_multiplier": { "type": ["number", "null"], "minimum": 0 },
        "usage_fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "isolation": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
